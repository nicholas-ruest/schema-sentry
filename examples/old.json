{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["query"],
  "properties": {
    "query": { "type": "string", "maxLength": 500 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "mode": { "enum": ["fast", "safe"] }
  },
  "additionalProperties": false
}
